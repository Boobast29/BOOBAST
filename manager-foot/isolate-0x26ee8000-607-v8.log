script-source,84,node:internal/vm/module,'use strict';\n\nconst {\n  Array\x2C\n  ArrayIsArray\x2C\n  ArrayPrototypeForEach\x2C\n  ArrayPrototypeIndexOf\x2C\n  ArrayPrototypeMap\x2C\n  ArrayPrototypeSome\x2C\n  ObjectDefineProperty\x2C\n  ObjectFreeze\x2C\n  ObjectGetPrototypeOf\x2C\n  ObjectPrototypeHasOwnProperty\x2C\n  ObjectSetPrototypeOf\x2C\n  PromisePrototypeThen\x2C\n  PromiseReject\x2C\n  PromiseResolve\x2C\n  ReflectApply\x2C\n  SafePromiseAllReturnArrayLike\x2C\n  Symbol\x2C\n  SymbolToStringTag\x2C\n  TypeError\x2C\n} = primordials;\n\nconst assert = require('internal/assert');\nconst {\n  isModuleNamespaceObject\x2C\n} = require('internal/util/types');\nconst {\n  customInspectSymbol\x2C\n  emitExperimentalWarning\x2C\n  getConstructorOf\x2C\n  kEmptyObject\x2C\n} = require('internal/util');\nconst {\n  ERR_INVALID_ARG_TYPE\x2C\n  ERR_INVALID_ARG_VALUE\x2C\n  ERR_VM_MODULE_ALREADY_LINKED\x2C\n  ERR_VM_MODULE_DIFFERENT_CONTEXT\x2C\n  ERR_VM_MODULE_CANNOT_CREATE_CACHED_DATA\x2C\n  ERR_VM_MODULE_LINK_FAILURE\x2C\n  ERR_MODULE_LINK_MISMATCH\x2C\n  ERR_VM_MODULE_NOT_MODULE\x2C\n  ERR_VM_MODULE_STATUS\x2C\n} = require('internal/errors').codes;\nconst {\n  validateBoolean\x2C\n  validateBuffer\x2C\n  validateFunction\x2C\n  validateInt32\x2C\n  validateObject\x2C\n  validateUint32\x2C\n  validateString\x2C\n  validateThisInternalField\x2C\n  validateArray\x2C\n} = require('internal/validators');\n\nconst binding = internalBinding('module_wrap');\nconst {\n  ModuleWrap\x2C\n  kUninstantiated\x2C\n  kInstantiating\x2C\n  kInstantiated\x2C\n  kEvaluating\x2C\n  kEvaluated\x2C\n  kErrored\x2C\n} = binding;\n\nconst STATUS_MAP = {\n  __proto__: null\x2C\n  [kUninstantiated]: 'unlinked'\x2C\n  [kInstantiating]: 'linking'\x2C\n  [kInstantiated]: 'linked'\x2C\n  [kEvaluating]: 'evaluating'\x2C\n  [kEvaluated]: 'evaluated'\x2C\n  [kErrored]: 'errored'\x2C\n};\n\nlet globalModuleId = 0;\nconst defaultModuleName = 'vm:module';\n\nconst kWrap = Symbol('kWrap');\nconst kContext = Symbol('kContext');\nconst kPerContextModuleId = Symbol('kPerContextModuleId');\nconst kLink = Symbol('kLink');\n\nconst { isContext } = require('internal/vm');\n\nfunction isModule(object) {\n  if (typeof object !== 'object' || object === null || !ObjectPrototypeHasOwnProperty(object\x2C kWrap)) {\n    return false;\n  }\n  return true;\n}\n\nclass Module {\n  constructor(options) {\n    emitExperimentalWarning('VM Modules');\n\n    if (new.target === Module) {\n      // eslint-disable-next-line no-restricted-syntax\n      throw new TypeError('Module is not a constructor');\n    }\n\n    const {\n      context\x2C\n      sourceText\x2C\n      syntheticExportNames\x2C\n      syntheticEvaluationSteps\x2C\n    } = options;\n\n    if (context !== undefined) {\n      validateObject(context\x2C 'context');\n      if (!isContext(context)) {\n        throw new ERR_INVALID_ARG_TYPE('options.context'\x2C 'vm.Context'\x2C\n                                       context);\n      }\n    }\n\n    let { identifier } = options;\n    if (identifier !== undefined) {\n      validateString(identifier\x2C 'options.identifier');\n    } else if (context === undefined) {\n      identifier = `${defaultModuleName}(${globalModuleId++})`;\n    } else if (context[kPerContextModuleId] !== undefined) {\n      const curId = context[kPerContextModuleId];\n      identifier = `${defaultModuleName}(${curId})`;\n      context[kPerContextModuleId] += 1;\n    } else {\n      identifier = `${defaultModuleName}(0)`;\n      ObjectDefineProperty(context\x2C kPerContextModuleId\x2C {\n        __proto__: null\x2C\n        value: 1\x2C\n        writable: true\x2C\n        enumerable: false\x2C\n        configurable: true\x2C\n      });\n    }\n\n    if (sourceText !== undefined) {\n      this[kWrap] = new ModuleWrap(identifier\x2C context\x2C sourceText\x2C\n                                   options.lineOffset\x2C options.columnOffset\x2C\n                                   options.cachedData);\n    } else {\n      assert(syntheticEvaluationSteps);\n      this[kWrap] = new ModuleWrap(identifier\x2C context\x2C\n                                   syntheticExportNames\x2C\n                                   syntheticEvaluationSteps);\n    }\n\n    this[kContext] = context;\n  }\n\n  get identifier() {\n    validateThisInternalField(this\x2C kWrap\x2C 'Module');\n    return this[kWrap].url;\n  }\n\n  get context() {\n    validateThisInternalField(this\x2C kWrap\x2C 'Module');\n    return this[kContext];\n  }\n\n  get namespace() {\n    validateThisInternalField(this\x2C kWrap\x2C 'Module');\n    if (this[kWrap].getStatus() < kInstantiated) {\n      throw new ERR_VM_MODULE_STATUS('must not be unlinked or linking');\n    }\n    return this[kWrap].getNamespace();\n  }\n\n  get status() {\n    validateThisInternalField(this\x2C kWrap\x2C 'Module');\n    return STATUS_MAP[this[kWrap].getStatus()];\n  }\n\n  get error() {\n    validateThisInternalField(this\x2C kWrap\x2C 'Module');\n    if (this[kWrap].getStatus() !== kErrored) {\n      throw new ERR_VM_MODULE_STATUS('must be errored');\n    }\n    return this[kWrap].getError();\n  }\n\n  async link(linker) {\n    validateThisInternalField(this\x2C kWrap\x2C 'Module');\n    validateFunction(linker\x2C 'linker');\n    if (this.status === 'linked') {\n      throw new ERR_VM_MODULE_ALREADY_LINKED();\n    }\n    if (this.status !== 'unlinked') {\n      throw new ERR_VM_MODULE_STATUS('must be unlinked');\n    }\n    await this[kLink](linker);\n    this[kWrap].instantiate();\n  }\n\n  evaluate(options = kEmptyObject) {\n    try {\n      validateThisInternalField(this\x2C kWrap\x2C 'Module');\n      validateObject(options\x2C 'options');\n\n      let timeout = options.timeout;\n      if (timeout === undefined) {\n        timeout = -1;\n      } else {\n        validateUint32(timeout\x2C 'options.timeout'\x2C true);\n      }\n      const { breakOnSigint = false } = options;\n      validateBoolean(breakOnSigint\x2C 'options.breakOnSigint');\n      const status = this[kWrap].getStatus();\n      if (status !== kInstantiated &&\n          status !== kEvaluated &&\n          status !== kErrored) {\n        throw new ERR_VM_MODULE_STATUS(\n          'must be one of linked\x2C evaluated\x2C or errored'\x2C\n        );\n      }\n      return this[kWrap].evaluate(timeout\x2C breakOnSigint);\n    } catch (e) {\n      return PromiseReject(e);\n    }\n  }\n\n  [customInspectSymbol](depth\x2C options) {\n    validateThisInternalField(this\x2C kWrap\x2C 'Module');\n    if (typeof depth === 'number' && depth < 0)\n      return this;\n\n    const constructor = getConstructorOf(this) || Module;\n    const o = { __proto__: { constructor } };\n    o.status = this.status;\n    o.identifier = this.identifier;\n    o.context = this.context;\n\n    ObjectSetPrototypeOf(o\x2C ObjectGetPrototypeOf(this));\n    ObjectDefineProperty(o\x2C SymbolToStringTag\x2C {\n      __proto__: null\x2C\n      value: constructor.name\x2C\n      configurable: true\x2C\n    });\n\n    // Lazy to avoid circular dependency\n    const { inspect } = require('internal/util/inspect');\n    return inspect(o\x2C { ...options\x2C customInspect: false });\n  }\n}\n\nconst kNoError = Symbol('kNoError');\n\nclass SourceTextModule extends Module {\n  #error = kNoError;\n  #statusOverride;\n\n  #moduleRequests;\n  #dependencySpecifiers;\n\n  constructor(sourceText\x2C options = kEmptyObject) {\n    validateString(sourceText\x2C 'sourceText');\n    validateObject(options\x2C 'options');\n\n    const {\n      lineOffset = 0\x2C\n      columnOffset = 0\x2C\n      initializeImportMeta\x2C\n      importModuleDynamically\x2C\n      context\x2C\n      identifier\x2C\n      cachedData\x2C\n    } = options;\n\n    validateInt32(lineOffset\x2C 'options.lineOffset');\n    validateInt32(columnOffset\x2C 'options.columnOffset');\n\n    if (initializeImportMeta !== undefined) {\n      validateFunction(initializeImportMeta\x2C 'options.initializeImportMeta');\n    }\n\n    if (importModuleDynamically !== undefined) {\n      validateFunction(importModuleDynamically\x2C 'options.importModuleDynamically');\n    }\n\n    if (cachedData !== undefined) {\n      validateBuffer(cachedData\x2C 'options.cachedData');\n    }\n\n    super({\n      sourceText\x2C\n      context\x2C\n      identifier\x2C\n      lineOffset\x2C\n      columnOffset\x2C\n      cachedData\x2C\n      initializeImportMeta\x2C\n      importModuleDynamically\x2C\n    });\n\n    const registry = {\n      __proto__: null\x2C\n      initializeImportMeta: options.initializeImportMeta\x2C\n      importModuleDynamically: options.importModuleDynamically ?\n        importModuleDynamicallyWrap(options.importModuleDynamically) :\n        undefined\x2C\n    };\n    // This will take precedence over the referrer as the object being\n    // passed into the callbacks.\n    registry.callbackReferrer = this;\n    const { registerModule } = require('internal/modules/esm/utils');\n    registerModule(this[kWrap]\x2C registry);\n\n    this.#moduleRequests = ObjectFreeze(ArrayPrototypeMap(this[kWrap].getModuleRequests()\x2C (request) => {\n      return ObjectFreeze({\n        __proto__: null\x2C\n        specifier: request.specifier\x2C\n        attributes: request.attributes\x2C\n      });\n    }));\n  }\n\n  async [kLink](linker) {\n    this.#statusOverride = 'linking';\n\n    // Iterates the module requests and links with the linker.\n    // Modules should be aligned with the moduleRequests array in order.\n    const modulePromises = Array(this.#moduleRequests.length);\n    // Iterates with index to avoid calling into userspace with `Symbol.iterator`.\n    for (let idx = 0; idx < this.#moduleRequests.length; idx++) {\n      const { specifier\x2C attributes } = this.#moduleRequests[idx];\n\n      const linkerResult = linker(specifier\x2C this\x2C {\n        attributes\x2C\n        assert: attributes\x2C\n      });\n      const modulePromise = PromisePrototypeThen(\n        PromiseResolve(linkerResult)\x2C async (module) => {\n          if (!isModule(module)) {\n            throw new ERR_VM_MODULE_NOT_MODULE();\n          }\n          if (module.context !== this.context) {\n            throw new ERR_VM_MODULE_DIFFERENT_CONTEXT();\n          }\n          if (module.status === 'errored') {\n            throw new ERR_VM_MODULE_LINK_FAILURE(`request for '${specifier}' resolved to an errored module`\x2C module.error);\n          }\n          if (module.status === 'unlinked') {\n            await module[kLink](linker);\n          }\n          return module[kWrap];\n        });\n      modulePromises[idx] = modulePromise;\n    }\n\n    try {\n      const modules = await SafePromiseAllReturnArrayLike(modulePromises);\n      this[kWrap].link(modules);\n    } catch (e) {\n      this.#error = e;\n      throw e;\n    } finally {\n      this.#statusOverride = undefined;\n    }\n  }\n\n  linkRequests(modules) {\n    validateThisInternalField(this\x2C kWrap\x2C 'SourceTextModule');\n    if (this.status !== 'unlinked') {\n      throw new ERR_VM_MODULE_STATUS('must be unlinked');\n    }\n    validateArray(modules\x2C 'modules');\n    if (modules.length !== this.#moduleRequests.length) {\n      throw new ERR_MODULE_LINK_MISMATCH(\n        `Expected ${this.#moduleRequests.length} modules\x2C got ${modules.length}`\x2C\n      );\n    }\n    const moduleWraps = ArrayPrototypeMap(modules\x2C (module) => {\n      if (!isModule(module)) {\n        throw new ERR_VM_MODULE_NOT_MODULE();\n      }\n      if (module.context !== this.context) {\n        throw new ERR_VM_MODULE_DIFFERENT_CONTEXT();\n      }\n      return module[kWrap];\n    });\n    this[kWrap].link(moduleWraps);\n  }\n\n  instantiate() {\n    validateThisInternalField(this\x2C kWrap\x2C 'SourceTextModule');\n    if (this.status !== 'unlinked') {\n      throw new ERR_VM_MODULE_STATUS('must be unlinked');\n    }\n    this[kWrap].instantiate();\n  }\n\n  get dependencySpecifiers() {\n    this.#dependencySpecifiers ??= ObjectFreeze(\n      ArrayPrototypeMap(this.#moduleRequests\x2C (request) => request.specifier));\n    return this.#dependencySpecifiers;\n  }\n\n  get moduleRequests() {\n    return this.#moduleRequests;\n  }\n\n  get status() {\n    if (this.#error !== kNoError) {\n      return 'errored';\n    }\n    if (this.#statusOverride) {\n      return this.#statusOverride;\n    }\n    return super.status;\n  }\n\n  get error() {\n    if (this.#error !== kNoError) {\n      return this.#error;\n    }\n    return super.error;\n  }\n\n  createCachedData() {\n    const { status } = this;\n    if (status === 'evaluating' ||\n        status === 'evaluated' ||\n        status === 'errored') {\n      throw new ERR_VM_MODULE_CANNOT_CREATE_CACHED_DATA();\n    }\n    return this[kWrap].createCachedData();\n  }\n}\n\nclass SyntheticModule extends Module {\n  constructor(exportNames\x2C evaluateCallback\x2C options = kEmptyObject) {\n    if (!ArrayIsArray(exportNames) ||\n      ArrayPrototypeSome(exportNames\x2C (e) => typeof e !== 'string')) {\n      throw new ERR_INVALID_ARG_TYPE('exportNames'\x2C\n                                     'Array of unique strings'\x2C\n                                     exportNames);\n    } else {\n      ArrayPrototypeForEach(exportNames\x2C (name\x2C i) => {\n        if (ArrayPrototypeIndexOf(exportNames\x2C name\x2C i + 1) !== -1) {\n          throw new ERR_INVALID_ARG_VALUE(`exportNames.${name}`\x2C\n                                          name\x2C\n                                          'is duplicated');\n        }\n      });\n    }\n    validateFunction(evaluateCallback\x2C 'evaluateCallback');\n\n    validateObject(options\x2C 'options');\n\n    const { context\x2C identifier } = options;\n\n    super({\n      syntheticExportNames: exportNames\x2C\n      syntheticEvaluationSteps: evaluateCallback\x2C\n      context\x2C\n      identifier\x2C\n    });\n    // A synthetic module does not have dependencies.\n    this[kWrap].link([]);\n    this[kWrap].instantiate();\n  }\n\n  link() {\n    validateThisInternalField(this\x2C kWrap\x2C 'SyntheticModule');\n    // No-op for synthetic modules\n    // Do not invoke super.link() as it will throw an error.\n  }\n\n  setExport(name\x2C value) {\n    validateThisInternalField(this\x2C kWrap\x2C 'SyntheticModule');\n    validateString(name\x2C 'name');\n    if (this[kWrap].getStatus() < kInstantiated) {\n      throw new ERR_VM_MODULE_STATUS('must be linked');\n    }\n    this[kWrap].setExport(name\x2C value);\n  }\n}\n\nfunction importModuleDynamicallyWrap(importModuleDynamically) {\n  const importModuleDynamicallyWrapper = async (specifier\x2C referrer\x2C attributes) => {\n    const m = await ReflectApply(\n      importModuleDynamically\x2C\n      this\x2C\n      [specifier\x2C referrer\x2C attributes]\x2C\n    );\n    if (isModuleNamespaceObject(m)) {\n      return m;\n    }\n    if (!isModule(m)) {\n      throw new ERR_VM_MODULE_NOT_MODULE();\n    }\n    if (m.status === 'errored') {\n      throw m.error;\n    }\n    return m.namespace;\n  };\n  return importModuleDynamicallyWrapper;\n}\n\nmodule.exports = {\n  Module\x2C\n  SourceTextModule\x2C\n  SyntheticModule\x2C\n  importModuleDynamicallyWrap\x2C\n};\n
